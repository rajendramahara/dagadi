PORT=8080
DB_PATH=./dagadi.db
JWT_SECRET=change-this-to-a-long-random-string
APP_ENV=development
# Only used when APP_ENV=development (no SMS sent, OTP is always this value)
DEV_FIXED_OTP=123456
# 2Factor custom OTP API. Keep this private; never put it in Flutter code.
TWO_FACTOR_API_KEY=
# Your 2Factor-approved sender ID, usually six capital letters, e.g. DAGADI.
TWO_FACTOR_SENDER_ID=
# Leave this unchanged unless 2Factor gives you a different endpoint.
TWO_FACTOR_BASE_URL=https://2factor.in
# Bootstrap admin password, seeded once on first boot only.
# Change it immediately via PATCH /api/v1/admin/credentials (Admin Settings).
DEFAULT_ADMIN_PASSWORD=changeme123
